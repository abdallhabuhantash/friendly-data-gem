# Real secrets and local state stay out of version control.
.env
snapshots/
state/
models/*.pt
__pycache__/
*.pyc
.venv/

# Real camera credentials must never be committed...
secrets/*.json
# ...but the safe templates are tracked.
!secrets/*.example.json

# Demo clips are local-only; the samples README stays tracked.
samples/*
!samples/README.md

# Benchmark output is local measurement data, never committed.
benchmark-results/

# Paper detector datasets and training runs are local-only.
datasets/
training-runs/
paper-eval-results/
