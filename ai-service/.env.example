# Vigilant Eye - local AI service configuration EXAMPLE.
# Copy to ai-service/.env and fill in real values. NEVER commit the real .env.
# Every name below is consumed by ai-service/app/config.py.

# --- Service ---
APP_ENV=development
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Supabase (service role key: local backend only, never in the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY
SNAPSHOT_BUCKET=snapshots

# --- Operational endpoint auth (must match the web app's AI_SERVICE_KEY) ---
# /status, /stream/{camera_id} and /snapshot/{camera_id} require this value in
# the X-Service-Key header. Empty means those endpoints stay closed.
AI_SERVICE_KEY=CHANGE_ME_LONG_RANDOM_STRING

# --- Model / inference ---
YOLO_MODEL=yolo11n.pt
# auto -> CUDA when available, otherwise CPU. Can be forced to cpu or cuda:0.
YOLO_DEVICE=auto
YOLO_IMGSZ=960
# Ultralytics tracker config: bytetrack.yaml or botsort.yaml
YOLO_TRACKER=bytetrack.yaml

# --- Loop timing ---
CONFIG_REFRESH_SECONDS=10.0
HEALTH_HEARTBEAT_SECONDS=10.0
CAMERA_HEARTBEAT_SECONDS=10.0
INFERENCE_MAX_FPS=0.0
PROCESS_EVERY_N_FRAMES=1

# --- Detection tuning ---
ASSOCIATION_MARGIN=0.12
DETECTION_GAP_TOLERANCE_SECONDS=0.5

# --- Demo sources (local MP4 instead of a physical camera) ---
DEMO_VIDEO_PATH=./samples/demo.mp4
# Optional per-camera mapping: {"camera-uuid":"./samples/other.mp4"}
DEMO_VIDEO_PATHS_JSON=
DEMO_VIDEO_LOOP=true

# --- Camera credentials ---
CAMERA_CREDENTIALS_FILE=./secrets/cameras.json
USE_SUPABASE_CAMERA_CREDENTIALS=false

# --- Local storage paths ---
SNAPSHOT_DIR=./snapshots
STATE_DIR=./state

# --- Telegram (optional, disabled by default) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_CHAT_ID
# Also push non-critical/uncertain events. Default: only definitive criticals.
TELEGRAM_SEND_WARNINGS=false

# --- Pose (OPTIONAL, asynchronous, OFF by default) ---
# Pose never blocks mobile-phone detection: it runs on its own worker with a
# single pending frame per camera (newest wins) and global concurrency of 1.
# Leaving POSE_ENABLED=false means nothing pose-related is constructed or copied.
POSE_ENABLED=false
# When POSE_ENABLED=true, ALL five settings below are REQUIRED and must be set
# explicitly: no model, device, input size, confidence floor or cadence is
# assumed on your behalf. Any missing value leaves pose inference unconfigured
# (reported as a configuration problem) while Task 1 starts normally.
POSE_MODEL=
POSE_DEVICE=
POSE_IMGSZ=
POSE_CONFIDENCE=
# Explicit pose cadence (frames/second per camera). Never derived from capture FPS.
POSE_MAX_FPS=

# Pose <-> tracked-person association stays UNCONFIGURED until all four
# site-calibrated gates below are set. There are no invented defaults.
POSE_ASSOC_MIN_BBOX_IOU=
POSE_ASSOC_MIN_POSE_CONTAINMENT=
POSE_ASSOC_MIN_AVAILABLE_KEYPOINTS=
POSE_ASSOC_MIN_KEYPOINT_INSIDE_RATIO=

# --- Anonymous exam-session subjects (S001, S002, …) -------------------------
# OFF by default. Nothing subject-related is constructed while disabled.
SUBJECTS_ENABLED=false
# When SUBJECTS_ENABLED=true, EVERY value below is REQUIRED. Frame rate, hall
# size, camera placement and tracker quality differ per site, so no default is
# invented: a missing value leaves anonymous subject tracking unconfigured
# (reported as a configuration problem) while the rest of the service runs.
#
# Temporal qualification — flicker must never create an identity.
SUBJECT_MIN_FRAMES_TO_QUALIFY=
SUBJECT_MIN_SECONDS_TO_QUALIFY=
# Gap handling. A subject is NEVER auto-ended: after the recovery window it is
# reported LOST and its number stays reserved for the whole session.
SUBJECT_LOST_AFTER_SECONDS=
SUBJECT_SHORT_GAP_SECONDS=
# Short-gap recovery gates (geometry + motion only; no appearance, no biometrics).
SUBJECT_REASSOCIATION_MIN_CONFIDENCE=
SUBJECT_REASSOCIATION_MARGIN=
# Score above which a lost subject counts as a plausible continuation, so a new
# raw track is held as UNRESOLVED instead of receiving a second number.
SUBJECT_PLAUSIBLE_CANDIDATE_SCORE=
# Mobility model: smoothing weight of the newest observation, bounded history,
# and the physically plausible speed in normalized frame widths per second.
# Motion beyond this speed is treated as a tracker swap, never as one person.
SUBJECT_MOTION_SMOOTHING=
SUBJECT_TRAJECTORY_LENGTH=
SUBJECT_MAX_SPEED_PER_SECOND=
# Frames a not-yet-qualified raw track may miss before its progress is dropped.
SUBJECT_PENDING_GAP_SECONDS=
